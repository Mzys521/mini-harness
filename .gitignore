# 环境变量文件(含密钥，禁止提交)
.env

# 旧版/临时目录(不参与版本管理)
del/

# Python 缓存
__pycache__/
*.py[cod]
.pytest_cache/

# 虚拟环境
.venv/
venv/

# 数据目录
data/
data

# 评测报告(每次运行的产物；evals/reports/baseline.json 作为回归基线入库)
evals/reports/latest.json

# 前端依赖与本地缓存(构建产物 harness/ui/static 需要入库)
node_modules/
frontend/dist/
.npm-cache/
*.tsbuildinfo

# Python 打包副作用
build/
*.egg-info/
.pkgcheck/
