# 环境变量文件(含密钥，禁止提交)
.env
.env.*
!.env.example

# 旧版/临时目录(不参与版本管理)
del/

# Python 缓存
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 虚拟环境
.venv/
venv/

# 数据目录与本地 SQLite
data/
data
*.db
*.db-shm
*.db-wal

# 评测报告(每次运行的产物；evals/reports/baseline.json 作为回归基线入库)
evals/reports/latest.json

# 前端依赖与本地缓存(构建产物 harness/ui/static 需要入库)
node_modules/
frontend/dist/
.npm-cache/
*.tsbuildinfo

# 打包副作用
build/
dist/
*.egg-info/
.pkgcheck/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local integration and browser verification artifacts
.test-tmp/
