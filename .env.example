# 文件：.env.example
# 复制为 .env 使用（.env 已被 .gitignore 排除，不会入库）。
#
# 只有下面这些变量会被直接读取：它们是凭据，或者必须在配置解析之前就确定。
# 其余设置（数据库路径、Worker 数量与租约、上下文预算、Guard 阈值、禁用工具、
# 审计路径、可观测性导出、计量参数……）一律写在 harness.toml 里；
# 需要随环境变化时，在 TOML 中用 ${VAR} / ${VAR:-default} 展开，例如：
#
#   [app]
#   database_path = "${HARNESS_DATABASE_PATH:-data/harness.db}"
#
# 详见 README「环境变量」与 docs/migration-v0.12-to-v0.13.md。

# 对话模型(DeepSeek)：默认 Provider，无需 OPENAI_API_KEY。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 显式切换 OpenAI Provider（harness.toml 里 provider = "openai"）时才需要。
OPENAI_API_KEY=
OPENAI_MODEL=

# 向量模型(阿里云 DashScope，RAG 检索用；Embedding 固定走这里)。
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=text-embedding-v3
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 商业平台(Phase 11)：必须长期稳定保存，每次启动随机变化会让已发行的 API Key 全部失效。
HARNESS_API_KEY_PEPPER=

# 覆盖 CLI 默认加载的项目应用工厂（默认 main:app）。
HARNESS_APP=main:app
